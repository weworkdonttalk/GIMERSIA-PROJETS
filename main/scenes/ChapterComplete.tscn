[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://assets/ui/gimersia_theme.tres" id="1_theme"]

[sub_resource type="GDScript" id="GDScript_complete"]
script/source = "extends Control

func _on_next_pressed() -> void:
	GameManager._on_level_completed()

func _on_menu_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/MainMenu.tscn\")
"

[node name="ChapterComplete" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = SubResource("GDScript_complete")

[node name="ColorRect" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.05, 0.12, 0.9)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="StatusLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "MEMORY RESTORED"
horizontal_alignment = 1

[node name="DescriptionLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
text = "The path forward has solidified before The Eraser arrived."
horizontal_alignment = 1

[node name="NextButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(220, 50)
layout_mode = 2
text = "CONTINUE"

[node name="MenuButton" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(220, 50)
layout_mode = 2
text = "RETURN TO MENU"

[connection signal="pressed" from="CenterContainer/VBoxContainer/NextButton" to="." method="_on_next_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/MenuButton" to="." method="_on_menu_pressed"]
